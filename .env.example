# Copy to `.env` for local Vite dev. Copy server secrets to `.dev.vars` for Wrangler (see `.dev.vars.example`).

# Razorpay (Dashboard → Settings → API Keys — use Test mode first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional: public key for checkout modal (never put KEY_SECRET here)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Razorpay (Dashboard → Webhooks → Add endpoint → copy secret)
# Webhook URL: https://YOUR_DOMAIN/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Pro plan price in Indian Rupees (one-time payment)
PRO_PLAN_AMOUNT_INR=1599
